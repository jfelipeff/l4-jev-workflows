{
  "name": "workflow-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Plain-language description -> Loopfour Studio workflow, with Jev (TypeSafe) instead of an LLM",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env.local --import tsx test/run.ts",
    "compare": "node --env-file-if-exists=.env.local --import tsx scripts/compare-llm.ts",
    "compare:functions": "node --env-file-if-exists=.env.local --import tsx scripts/compare-functions.ts"
  },
  "engines": { "node": "24.x" },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
